# =========================
# Database
# =========================

DB_NAME=app_db
DB_USERNAME=
DB_PASSWORD=
DB_PORT=5432
DB_HOST=localhost

# =========================
# Application
# =========================

APP_PORT=8081
ALLOWED_ORIGINS=http://localhost:5500


# =========================
# Security
# =========================

SECRET_KEY=
TOKEN_EXP=604800000
REFRESH_EXP=604800000

# Firebase project ID (Firebase Console > Project settings > General)
# Phải trùng project đã ký Firebase ID token mà frontend dùng
FIREBASE_PROJECT_ID=miniodrive-2f366

# =========================
# Email (SMTP) - để trống MAIL_HOST để dev log link verify ra console
# =========================

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=


# =========================
# Object Storage
# =========================

STORAGE_BUCKET=mini-drive
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=admin
STORAGE_SECRET_KEY=admin123

RUSTFS_ACCESS_KEY=admin
RUSTFS_SECRET_KEY=admin123

RUSTFS_API_PORT=9000
RUSTFS_CONSOLE_PORT=9001

STORAGE_ENDPOINT=http://localhost:9000
